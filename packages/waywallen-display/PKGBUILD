# Maintainer: LocalT0aster <90502400+LocalT0aster@users.noreply.github.com>

pkgname=waywallen-display
pkgver=0.4.0
pkgrel=1
pkgdesc='Desktop integration for waywallen'
arch=('x86_64')
url='https://github.com/waywallen/waywallen-display'
license=('MIT')
depends=('glibc' 'libglvnd' 'vulkan-icd-loader' 'wayland')
makedepends=('rust' 'ccache' 'cmake' 'gettext' 'glib2' 'gobject-introspection' 'gtk4' 'ninja' 'pkgconf' 'qt6-base' 'qt6-declarative' 'vulkan-headers')
optdepends=('qt6-declarative: KDE Plasma integration' 'gtk4: GNOME Shell integration')
conflicts=('plasma-wallpaper-waywallen')
replaces=('plasma-wallpaper-waywallen')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('191e8a8f575288d25e1e4f9999c74dfd4bfa81404f42eabbe069c761e45f3607')

build() {
  export CFLAGS="${CFLAGS//-Wp,-D_FORTIFY_SOURCE=3/}"
  export CXXFLAGS="${CXXFLAGS//-Wp,-D_FORTIFY_SOURCE=3/}"
  export CPPFLAGS="${CPPFLAGS//-D_FORTIFY_SOURCE=3/}"
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto=auto/}"
  export CCACHE_BASEDIR="${srcdir}"
  export CCACHE_COMPILERCHECK=content
  cmake -S "${pkgname}-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DWAYWALLEN_DISPLAY_PLUGIN_QML=ON \
    -DWAYWALLEN_DISPLAY_PLUGIN_GOBJECT=ON
  cmake --build build
  cargo build --manifest-path "${pkgname}-${pkgver}/Cargo.toml" --bin waywallen-layer-shell --release --locked
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm755 "${pkgname}-${pkgver}/target/release/waywallen-layer-shell" "${pkgdir}/usr/bin/waywallen-layer-shell"
  install -d "${pkgdir}/usr/share/plasma/wallpapers"
  cp -a "${pkgname}-${pkgver}/extensions/kde/package" "${pkgdir}/usr/share/plasma/wallpapers/org.waywallen.kde"
  install -Dm644 "${pkgname}-${pkgver}/extensions/kde/package/contents/ui/Wrapper/PluginDisplay.qml" \
    "${pkgdir}/usr/share/plasma/wallpapers/org.waywallen.kde/contents/ui/Plugin/PluginDisplay.qml"
  install -Dm644 "${pkgname}-${pkgver}/extensions/kde/package/contents/ui/Wrapper/PluginInfo.qml" \
    "${pkgdir}/usr/share/plasma/wallpapers/org.waywallen.kde/contents/ui/Plugin/PluginInfo.qml"
  install -Dm644 "${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
