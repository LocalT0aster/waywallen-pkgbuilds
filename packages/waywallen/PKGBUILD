# Maintainer: LocalT0aster <90502400+LocalT0aster@users.noreply.github.com>

pkgname=waywallen
pkgver=0.6.3
pkgrel=5
pkgdesc='Wallpaper manager for Linux'
arch=('x86_64')
url='https://github.com/waywallen/waywallen'
license=('MIT')
depends=('ffmpeg' 'glibc' 'libglvnd' 'libpulse' 'libxkbcommon' 'lua>=5.5' 'mesa' 'qt6-base>=6.10' 'qt6-declarative>=6.10' 'qt6-grpc' 'qt6-websockets' 'sqlite' 'vulkan-icd-loader' 'zstd')
makedepends=('rust' 'clang>=22' 'cmake>=3.28' 'git' 'git-lfs' 'lld' 'llvm' 'ninja' 'pkgconf' 'protobuf' 'qt6-shadertools' 'qt6-tools' 'vulkan-headers')
optdepends=('waywallen-display: desktop integration clients')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
          'lito-v0.8.13-linux-x86_64.tar.gz::https://github.com/litocpp/lito/releases/download/v0.8.13/lito-v0.8.13-linux-x86_64.tar.gz'
          'page-popup-fixed-size.patch')
sha256sums=('d12a87acd2aec7d72da72d4a4f6756d919f3476c5d731925f7c04fd6f76cf96e'
            '055399f009c95977e6727cce0b0f918bb3fbf51c9f806b5064ece459a31bfc4f'
            '9ce2828eddfe9feab78cbdfe6a2622d9799ab7424a220e8e2f412332558344bf')

prepare() {
  cd "${pkgname}-${pkgver}"
  # v0.6.0 rewrote popup sizing and no longer has the affected bindings.
  if (( $(vercmp "$pkgver" 0.6.0) < 0 )); then
    patch -Np1 -i "${srcdir}/page-popup-fixed-size.patch"
  fi
}

build() {
  export CC=clang
  export CXX=clang++
  cd "${pkgname}-${pkgver}"
  lito="${srcdir}/lito-v0.8.13-linux-x86_64/bin/lito"
  "$lito" fetch --locked
  for checkout in "${HOME}/.local/share/lito/git/checkouts/QmlMaterial-"*/*; do
    [[ -d $checkout ]] || continue
    # Without the per-repo filter config "lfs pull" downloads objects but skips
    # smudge, leaving pointer stubs that compile into broken icon resources.
    git -C "$checkout" lfs install --local
    git -C "$checkout" lfs pull
    if find "$checkout" -name .git -prune -o -type f \( -name '*.png' -o -name '*.svg' \) -print0 | xargs -0 -r grep -Ilq '^version https://git-lfs'; then
      printf 'Unsmudged LFS pointer files remain in QmlMaterial checkout\n' >&2
      exit 1
    fi
  done
  "$lito" install \
    --no-config \
    --locked \
    --profile release \
    --prefix "${srcdir}/waywallen-stage/usr" \
    --config 'tools.cmake.search-path=["/usr"]'
}

package() {
  cp -a "${srcdir}/waywallen-stage/." "${pkgdir}/"
  install -Dm644 "${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
