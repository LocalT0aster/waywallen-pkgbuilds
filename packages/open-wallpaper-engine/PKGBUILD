# Maintainer: LocalT0aster <90502400+LocalT0aster@users.noreply.github.com>

pkgname=waywallen-open-wallpaper-engine
pkgver=0.2.9
pkgrel=1
pkgdesc='Wallpaper Engine renderer plugin for waywallen'
arch=('x86_64')
url='https://github.com/waywallen/open-wallpaper-engine'
license=('GPL-2.0-only')
depends=('alsa-lib' 'ffmpeg' 'fontconfig' 'freetype2' 'glibc' 'gtk3' 'libglvnd' 'libx11' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'libxrender' 'libxss' 'libxcb' 'lz4' 'mesa' 'nss' 'vulkan-icd-loader' 'wayland' 'waywallen>=0.3.6')
makedepends=('ccache' 'clang>=22' 'cmake>=4.0' 'eigen' 'git' 'glslang' 'lld' 'llvm' 'nasm' 'ninja' 'patchelf' 'pkgconf' 'vulkan-headers')
source=("open-wallpaper-engine-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'lito-v0.7.1-linux-x86_64.tar.gz::https://github.com/litocpp/lito/releases/download/v0.7.1/lito-v0.7.1-linux-x86_64.tar.gz')
sha256sums=('508e54aeb8f6acc36ccef787230aa1f8dbeea75f5ed217b472c6c01d488a5b71'
            '2987265fc8a0fcbe3bc84cad9501441349b25bfd64ef17dc024591caf079cb6a')

build() {
  export CC=clang
  export CXX=clang++
  export CCACHE_BASEDIR="${srcdir}"
  export CCACHE_COMPILERCHECK=content
  cd "open-wallpaper-engine-${pkgver}"
  "${srcdir}/lito-v0.7.1-linux-x86_64/bin/lito" install -p owe-waywallen-plugin \
    --prefix "${srcdir}/owe-stage/usr" \
    --config 'tools.cmake.search-path=["/usr"]'
}

package() {
  cp -a "${srcdir}/owe-stage/." "${pkgdir}/"
  patchelf --set-rpath '$ORIGIN' "${pkgdir}/usr/lib/weweb/waywallen-weweb-renderer"
  install -Dm644 "open-wallpaper-engine-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
