# Maintainer: LocalT0aster <90502400+LocalT0aster@users.noreply.github.com>

pkgname=waywallen-open-wallpaper-engine
pkgver=0.4.1
pkgrel=2
pkgdesc='Wallpaper Engine renderer plugin for waywallen'
arch=('x86_64')
url='https://github.com/waywallen/open-wallpaper-engine'
license=('GPL-2.0-only')
depends=('alsa-lib' 'ffmpeg' 'fontconfig' 'freetype2' 'glibc' 'gtk3' 'libglvnd' 'libx11' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'libxrender' 'libxss' 'libxcb' 'lz4' 'mesa' 'nss' 'openal' 'vulkan-icd-loader' 'wayland' 'waywallen>=0.3.6')
makedepends=('ccache' 'clang>=22' 'cmake>=4.0' 'eigen' 'git' 'glslang' 'lld' 'llvm' 'nasm' 'ninja' 'patchelf' 'pkgconf' 'vulkan-headers')
source=("open-wallpaper-engine-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'lito-v0.8.13-linux-x86_64.tar.gz::https://github.com/litocpp/lito/releases/download/v0.8.13/lito-v0.8.13-linux-x86_64.tar.gz')
sha256sums=('06a148a4312080b066afa98562f434a228657cfa9c440778df2b85817072e32e'
            '055399f009c95977e6727cce0b0f918bb3fbf51c9f806b5064ece459a31bfc4f')

build() {
  export CC=clang
  export CXX=clang++
  export CCACHE_BASEDIR="${srcdir}"
  export CCACHE_COMPILERCHECK=content
  cd "open-wallpaper-engine-${pkgver}"
  "${srcdir}/lito-v0.8.13-linux-x86_64/bin/lito" install -p owe-waywallen-plugin \
    --prefix "${srcdir}/owe-stage/usr" \
    --config 'tools.cmake.search-path=["/usr"]'
}

package() {
  cp -a "${srcdir}/owe-stage/." "${pkgdir}/"
  patchelf --set-rpath '$ORIGIN' "${pkgdir}/usr/bin/weweb/owe-web"
  install -Dm644 "open-wallpaper-engine-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
